# Normalise line endings in the repository to LF, regardless of the platform a
# contributor commits from. This matters more than usual here: the project
# ships shell scripts and systemd units that a CRLF checkout would break on
# Linux, and Go tooling assumes LF.
* text=auto eol=lf

# Windows-only files keep CRLF in the working copy.
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Files that must stay LF even on Windows checkouts.
*.sh        text eol=lf
*.service   text eol=lf

# Binary — never touch.
*.png   binary
*.jpg   binary
*.ico   binary
*.pdf   binary
*.exe   binary
*.gz    binary
*.zip   binary
